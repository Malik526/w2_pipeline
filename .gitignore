# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# JavaScript / Next.js
node_modules/
.next/
out/
dist/

# Local databases and runtime state
*.sqlite
*.sqlite3
*.db

# Real taxpayer/source documents must stay local.
data/documents/**
!data/documents/
!data/documents/README.md

# Private evaluation material must stay local unless explicitly sanitized.
data/evaluation/private/**

# Reproducible generated evaluation assets stay out of Git by default.
data/evaluation/generated/**
data/evaluation/external/**

# Local long-running benchmark run-control files.
data/evaluation/results/*.log
data/evaluation/results/*.pid

# Review records may carry real taxpayer PII in production use; keep local.
data/review/**
!data/review/
!data/review/README.md

# Phase 8D.7 demo UI: staged uploads and per-run UI output are ephemeral
# session state, not committed project artifacts.
data/ui_uploads/**
!data/ui_uploads/
!data/ui_uploads/README.md
output/ui/

# `frontend/` carries its own create-next-app .gitignore (node_modules,
# .next/, .env*, etc.); nothing frontend-specific needs duplicating here.
